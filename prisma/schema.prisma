// =============================================================================
// Schema — MySQL/MariaDB (banco gerenciado da Hostinger)
// - Moeda virtual: Int. Dinheiro real: centavos.
// - Saldo só muda via src/server/ledger.ts (partidas dobradas, soma zero).
// - Mídia nunca é pública: servida por /api/media/[id] com checagem de acesso.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ProfileType {
  COUPLE_MF
  COUPLE_MM
  COUPLE_FF
  SINGLE_WOMAN
  SINGLE_MAN
  TRANS
  OTHER
}

enum PmPolicy {
  EVERYONE
  FRIENDS
  FOLLOWING
  COUPLES
  NOBODY
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum MediaKind {
  AVATAR
  POST
  POST_VIDEO
  PRIVATE_ALBUM
  PM_PHOTO
  VERIFICATION_SELFIE
  ROOM_COVER
  ROOM_PHOTO
  EVENT_COVER
  STORY
}

enum MediaStatus {
  APPROVED
  QUARANTINED
  REMOVED
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  FOLLOWERS
}

enum RoomAccess {
  PUBLIC
  MEMBERS_ONLY
  COUPLES_ONLY
  VERIFIED_ONLY
}

enum RoomRole {
  OWNER
  MODERATOR
  MEMBER
}

enum RoomSanctionType {
  MUTE
  BAN
}

enum MessageKind {
  TEXT
  SYSTEM
  GIFT
  ANNOUNCEMENT
}

enum ItemCategory {
  DOLL
  GLOW
  NICK_COLOR
  TEXT_COLOR
  BADGE
  AVATAR_FRAME
  ENTRY_EFFECT
  POWER
}

enum ItemRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  LIMITED
}

enum WalletKind {
  USER
  SYSTEM_MINT
  SYSTEM_SINK
}

enum LedgerTxType {
  REWARD
  TIP
  TRADE
  PURCHASE_CREDIT
  VIP_BONUS
  ITEM_PURCHASE
  GIFT_COINS
  GIFT_ITEM
  ADMIN_ADJUSTMENT
  REFUND
}

enum PaymentStatus {
  PENDING // criado, aguardando o usuário pagar
  CLAIMED // usuário disse "já paguei"
  PAID // admin confirmou; moedas creditadas
  REJECTED
  EXPIRED
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  ROOM_MESSAGE
  PRIVATE_MESSAGE
  MEDIA
  ROOM
  LIVE
  EVENT
  TESTIMONIAL
}

enum ReportReason {
  POSSIBLE_MINOR
  NON_CONSENSUAL
  ILLEGAL_CONTENT
  HARASSMENT
  FAKE_PROFILE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ESCALATED
  RESOLVED
  DISMISSED
}

enum NotificationKind {
  MATCH
  PROFILE_LIKE
  TESTIMONIAL
  EVENT
  LIVE
  TRADE
  TICKET
  FOLLOW
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  COMMENT_REPLY
  COMMENT_REACTION
  POST_REACTION
  POST_COMMENT
  MENTION
  ALBUM_REQUEST
  ALBUM_GRANTED
  GIFT
  COINS_CREDITED
  VERIFICATION
  SYSTEM
}

// -----------------------------------------------------------------------------
// Usuário + perfil
// -----------------------------------------------------------------------------

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  nick               String             @unique @db.VarChar(24)
  birthDate          DateTime           @db.Date
  role               PlatformRole       @default(USER)
  status             UserStatus         @default(ACTIVE)
  ageVerification    VerificationStatus @default(NONE)
  ageVerifiedAt      DateTime?
  // perfil
  profileType        ProfileType
  bio                String?            @db.Text
  statusText         String?            @db.VarChar(60) // frase curta sob o nick no chat (estilo xat)
  city               String?            @db.VarChar(80)
  state              String?            @db.VarChar(2)
  hideCity           Boolean            @default(false)
  hideFromUnverified Boolean            @default(false)
  likes              Json? // string[]
  pmPolicy           PmPolicy           @default(FRIENDS) // amizade libera o PV
  acceptPmPhotos     Boolean            @default(false)
  albumVisibility    String             @default("FRIENDS") @db.VarChar(10) // PRIVATE | FRIENDS | FOLLOWERS
  avatarId           String?
  vipUntil           DateTime? // assinante até (cache de Subscription)
  twoFactorSecret    String?            @db.VarChar(64) // TOTP (base32); ativo quando twoFactorEnabled
  twoFactorEnabled   Boolean            @default(false)
  googleSub          String?            @db.VarChar(64) // login com Google (unicidade garantida no código)
  lat                Float? // coordenadas aproximadas (cidade ou aparelho, 2 casas ~1 km)
  lng                Float?
  geoSource          String?            @db.VarChar(5) // CITY | GPS
  showDistance       Boolean            @default(true) // aparece nas buscas por raio
  lastSeenAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  persons              ProfilePerson[]
  sessions             Session[]
  consents             ConsentRecord[]
  verifications        VerificationRequest[]
  media                Media[]
  posts                Post[]
  comments             PostComment[]
  postReactions        PostReaction[]
  following            Follow[]              @relation("Follower")
  followers            Follow[]              @relation("Followee")
  blocking             Block[]               @relation("Blocker")
  blockedBy            Block[]               @relation("Blocked")
  roomsOwned           Room[]
  roomMemberships      RoomMember[]
  messages             Message[]
  pmSent               PrivateMessage[]
  wallet               Wallet?
  inventory            InventoryItem[]
  payments             Payment[]
  subscriptions        Subscription[]
  reportsFiled         Report[]              @relation("Reporter")
  notifications        Notification[]        @relation("NotifUser")
  albumOwned           AlbumAccess[]         @relation("AlbumOwner")
  friendsSent          Friendship[]          @relation("FriendRequester")
  tickets              Ticket[]
  friendsReceived      Friendship[]          @relation("FriendAddressee")
  albumViewing         AlbumAccess[]         @relation("AlbumViewer")
  liveStreams          LiveStream[]
  liveMessages         LiveMessage[]
  events               Event[]
  testimonialsReceived Testimonial[]         @relation("TestimonialsReceived")
  testimonialsWritten  Testimonial[]         @relation("TestimonialsWritten")
  stories              Story[]               @relation("StoriesAuthored")
  albums               Album[]               @relation("AlbumsOwned")
  pushSubscriptions    PushSubscription[]    @relation("PushSubscriptions")
  /// preferências de push: { discreet: bool, groups: { pm: bool, ... } }
  pushPrefs            Json?
  /// cartão "Primeiros passos" escondido pela pessoa
  onboardingHiddenAt   DateTime?
  /// não aparecer para outros na Paquera
  paqueraHidden        Boolean               @default(false)

  @@index([state, city])
  @@index([createdAt])
  @@index([googleSub])
  @@index([lat, lng])
}

// 1 pessoa (solteiro) ou 2 (casal). Todas 18+.
model ProfilePerson {
  id          String   @id @default(cuid())
  userId      String
  label       String   @db.VarChar(20)
  birthDate   DateTime @db.Date
  // características opcionais (sobre ela / sobre ele)
  orientation String?  @db.VarChar(30)
  heightCm    Int?
  body        String?  @db.VarChar(30)
  skin        String?  @db.VarChar(30)
  hair        String?  @db.VarChar(30)
  eyes        String?  @db.VarChar(30)
  tattoos     String?  @db.VarChar(30)
  smoker      String?  @db.VarChar(30)
  drinks      String?  @db.VarChar(30)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id                String             @id @default(cuid())
  userId            String
  tokenHash         String             @unique
  ip                String             @db.VarChar(64)
  userAgent         String?            @db.VarChar(255)
  createdAt         DateTime           @default(now())
  expiresAt         DateTime
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(32) // TERMS | PRIVACY | SENSITIVE_DATA | AGE_18
  version   String   @db.VarChar(16)
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Selfie com gesto sorteado, revisada por moderador
model VerificationRequest {
  id           String             @id @default(cuid())
  userId       String
  gesture      String             @db.VarChar(120)
  mediaId      String
  status       VerificationStatus @default(PENDING)
  reviewerId   String?
  reviewedAt   DateTime?
  rejectReason String?            @db.VarChar(255)
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model AlbumAccess {
  ownerId   String
  viewerId  String
  granted   Boolean  @default(false)
  createdAt DateTime @default(now())
  owner     User     @relation("AlbumOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer    User     @relation("AlbumViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([ownerId, viewerId])
  @@index([viewerId])
}

// -----------------------------------------------------------------------------
// Mídia
// -----------------------------------------------------------------------------

model Media {
  id          String      @id @default(cuid())
  ownerId     String
  kind        MediaKind
  status      MediaStatus @default(APPROVED)
  originalKey String      @db.VarChar(255) // nunca servido a terceiros
  displayKey  String      @db.VarChar(255) // redimensionado + marca d'água
  blurKey     String      @db.VarChar(255) // prévia borrada
  width       Int
  height      Int
  sha256      String      @db.VarChar(64)
  mime        String      @default("image/webp") @db.VarChar(40) // vídeo: mime do arquivo em originalKey
  sizeBytes   Int         @default(0)
  /// álbum por tema (null = álbum privado padrão)
  albumId     String?
  createdAt   DateTime    @default(now())
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postMedia   PostMedia[]

  @@index([ownerId, kind])
  @@index([albumId])
  @@index([sha256])
}

model MediaHashBlock {
  sha256    String   @id @db.VarChar(64)
  reason    String   @db.VarChar(120)
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Feed (estilo Sexlog)
// -----------------------------------------------------------------------------

model Post {
  id         String         @id @default(cuid())
  authorId   String
  body       String?        @db.Text
  visibility PostVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())
  deletedAt  DateTime?
  groupId    String? // post feito dentro de um grupo (não aparece no feed principal)
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media      PostMedia[]
  comments   PostComment[]
  reactions  PostReaction[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
}

model PostMedia {
  postId   String
  mediaId  String
  position Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
}

model PostReaction {
  postId    String
  userId    String
  emoji     String   @db.VarChar(8)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostComment {
  id        String            @id @default(cuid())
  postId    String
  authorId  String
  parentId  String? // resposta a outro comentário (1 nível)
  body      String            @db.VarChar(1000)
  createdAt DateTime          @default(now())
  deletedAt DateTime?
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  commentId String
  userId    String
  emoji     String      @db.VarChar(8)
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

// Amizade: pedido (PENDING) -> aceito (ACCEPTED). Um registro por par.
model Friendship {
  requesterId String
  addresseeId String
  status      String    @default("PENDING") @db.VarChar(10) // PENDING | ACCEPTED
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  requester   User      @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User      @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  actorId   String?
  refId     String?
  text      String           @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotifUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Salas (estilo xat)
// -----------------------------------------------------------------------------

model Room {
  id              String           @id @default(cuid())
  slug            String           @unique @db.VarChar(32)
  name            String           @db.VarChar(60)
  description     String?          @db.VarChar(500)
  rules           String?          @db.Text
  theme           String           @default("noir") @db.VarChar(20)
  city            String?          @db.VarChar(80)
  state           String?          @db.VarChar(2)
  isOfficial      Boolean          @default(false)
  ownerId         String?
  access          RoomAccess       @default(PUBLIC)
  slowModeSeconds Int              @default(0)
  linksAllowed    Boolean          @default(false)
  mediaPolicy     String           @default("NOBODY") @db.VarChar(10) // chat das salas é só texto (fotos ficam no feed/perfil)
  bgMediaId       String? // foto de fundo/capa enviada pelo dono
  pinnedMessageId BigInt?
  createdAt       DateTime         @default(now())
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members         RoomMember[]
  bannedWords     RoomBannedWord[]
  sanctions       RoomSanction[]
  messages        Message[]
  presence        RoomPresence[]

  @@index([isOfficial])
}

model RoomMember {
  roomId   String
  userId   String
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model RoomBannedWord {
  roomId String
  word   String @db.VarChar(60)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, word])
}

model RoomSanction {
  id         String           @id @default(cuid())
  roomId     String
  userId     String
  type       RoomSanctionType
  reason     String?          @db.VarChar(255)
  issuedById String
  createdAt  DateTime         @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  room       Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, userId])
}

// Presença via heartbeat (substitui Redis no plano sem VPS)
model RoomPresence {
  roomId      String
  userId      String
  lastSeenAt  DateTime
  typingUntil DateTime?
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([roomId, lastSeenAt])
}

model Message {
  id        BigInt            @id @default(autoincrement())
  roomId    String
  authorId  String?
  kind      MessageKind       @default(TEXT)
  body      String            @db.VarChar(1000)
  mediaId   String? // legado: o chat é só texto
  createdAt DateTime          @default(now())
  deletedAt DateTime?
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions MessageReaction[]

  @@index([roomId, id])
  @@index([authorId, createdAt])
  @@index([createdAt])
}

model MessageReaction {
  messageId BigInt
  userId    String
  emoji     String   @db.VarChar(8)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model Announcement {
  id        String    @id @default(cuid())
  body      String    @db.VarChar(500)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

// -----------------------------------------------------------------------------
// PV
// -----------------------------------------------------------------------------

model Conversation {
  id            String           @id @default(cuid())
  userAId       String // menor id do par
  userBId       String
  lastMessageAt DateTime         @default(now())
  lastSenderId  String?
  aReadAt       DateTime?
  bReadAt       DateTime?
  messages      PrivateMessage[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model PrivateMessage {
  id             BigInt       @id @default(autoincrement())
  conversationId String
  senderId       String
  body           String?      @db.VarChar(2000)
  mediaId        String?
  revealedAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
}

// -----------------------------------------------------------------------------
// Economia
// -----------------------------------------------------------------------------

model Wallet {
  id      String        @id @default(cuid())
  kind    WalletKind    @default(USER)
  userId  String?       @unique
  balance Int           @default(0)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([kind])
}

model LedgerTransaction {
  id             String        @id @default(cuid())
  type           LedgerTxType
  idempotencyKey String        @unique @db.VarChar(120)
  note           String?       @db.VarChar(255)
  actorId        String?
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  walletId      String
  amount        Int
  balanceAfter  Int
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  wallet        Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
}

// config = JSON tipado por categoria, compilado para CSS em src/lib/items.ts
model Item {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(60)
  name        String          @db.VarChar(80)
  description String?         @db.VarChar(255)
  category    ItemCategory
  rarity      ItemRarity      @default(COMMON)
  config      Json
  powerScore  Int             @default(0)
  price7      Int? // preço 7 dias
  price30     Int? // preço 30 dias
  pricePerm   Int? // preço permanente
  limitedQty  Int?
  soldCount   Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  inventory   InventoryItem[]

  @@index([category, active])
}

model InventoryItem {
  id        String    @id @default(cuid())
  userId    String
  itemId    String
  active    Boolean   @default(false)
  expiresAt DateTime?
  giftFrom  String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@index([userId, active])
}

model CoinPackage {
  id         String  @id @default(cuid())
  name       String  @db.VarChar(60)
  coins      Int
  bonusCoins Int     @default(0)
  priceCents Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// Pagamento manual via Pix: usuário paga no QR da chave, clica "já paguei",
// admin confere e aprova -> crédito idempotente (payment:<id>).
model Payment {
  id           String        @id @default(cuid())
  userId       String
  kind         String        @default("COINS") @db.VarChar(10) // COINS | VIP
  vipDays      Int?
  provider     String        @default("pix_manual") @db.VarChar(30)
  code         String        @unique @db.VarChar(12) // identificador p/ o usuário citar
  providerRef  String?       @db.VarChar(120) // id da cobrança no gateway (quando não é Pix manual)
  chargeData   String?       @db.Text // copia-e-cola ou URL devolvidos pelo gateway (criados 1x)
  status       PaymentStatus @default(PENDING)
  amountCents  Int
  coins        Int
  packageName  String        @db.VarChar(60)
  couponCode   String?       @db.VarChar(30)
  payerName    String?       @db.VarChar(120)
  reviewedById String?
  reviewedAt   DateTime?
  ledgerTxId   String?       @unique
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Cupom de bônus em recargas (ex.: BEMVINDO = +20% de moedas)
model Coupon {
  code         String    @id @db.VarChar(30) // maiúsculas
  bonusPercent Int       @default(0)
  maxUses      Int? // total na plataforma
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// Assinatura (perfil assinante: assiste vídeos, selo VIP, bônus de moedas)
model VipPlan {
  id         String  @id @default(cuid())
  name       String  @db.VarChar(60)
  days       Int
  priceCents Int
  bonusCoins Int     @default(0)
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// Histórico de períodos de assinatura (User.vipUntil é o cache do fim atual)
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  paymentId String?  @unique
  startsAt  DateTime
  endsAt    DateTime
  source    String   @db.VarChar(20) // PIX | ADMIN
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
}

// Todo webhook de gateway é gravado ANTES de processar; (provider, eventId) único
// garante que reentregas não creditem duas vezes.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @db.VarChar(30)
  eventId     String    @db.VarChar(120)
  type        String    @db.VarChar(60)
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?   @db.VarChar(500)

  @@unique([provider, eventId])
}

// -----------------------------------------------------------------------------
// Denúncias / moderação / legal
// -----------------------------------------------------------------------------

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String           @db.VarChar(64)
  targetUserId String?
  reason       ReportReason
  details      String?          @db.VarChar(1000)
  priority     Int
  status       ReportStatus     @default(OPEN)
  evidence     Json?
  resolution   String?          @db.VarChar(500)
  resolvedById String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  reporter     User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
}

model BanFingerprint {
  id        String    @id @default(cuid())
  kind      String    @db.VarChar(10) // IP | EMAIL
  valueHash String    @db.VarChar(64)
  reason    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([kind, valueHash])
}

// Marco Civil art. 15 — 6 meses
model AccessLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  event     String   @db.VarChar(32)
  ip        String   @db.VarChar(64)
  port      Int?
  deviceId  String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  action     String   @db.VarChar(60)
  targetType String?  @db.VarChar(30)
  targetId   String?  @db.VarChar(64)
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

// Suporte: chamados do usuário para a administração (inclui troca de nick)
model Ticket {
  id            String          @id @default(cuid())
  userId        String
  category      String          @db.VarChar(20) // NICK_CHANGE | PAYMENT | ACCOUNT | VERIFICATION | REPORT | SUGGESTION | OTHER
  subject       String          @db.VarChar(120)
  status        String          @default("OPEN") @db.VarChar(12) // OPEN | ANSWERED | CLOSED
  requestedNick String?         @db.VarChar(24)
  requestedData Json? // troca de tipo de perfil: { type, births[] }
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  fromStaff Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Troca segura entre usuários (estilo xat trade): Pimentas, itens permanentes e dias de assinatura.
// Qualquer alteração de oferta incrementa `version`, zera aceites/confirmações e trava por alguns segundos.
model Trade {
  id          String      @id @default(cuid())
  aId         String // quem propôs
  bId         String
  status      String      @default("PENDING") @db.VarChar(12) // PENDING | COMPLETED | CANCELLED | EXPIRED
  version     Int         @default(1)
  aCoins      Int         @default(0)
  bCoins      Int         @default(0)
  aVipDays    Int         @default(0)
  bVipDays    Int         @default(0)
  aAccepted   Boolean     @default(false)
  bAccepted   Boolean     @default(false)
  aConfirmed  Boolean     @default(false)
  bConfirmed  Boolean     @default(false)
  lockedUntil DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?
  items       TradeItem[]

  @@index([aId, status])
  @@index([bId, status])
}

model TradeItem {
  tradeId         String
  inventoryItemId String
  side            String @db.VarChar(1) // A | B
  trade           Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@id([tradeId, inventoryItemId])
}

model PlatformSetting {
  key   String @id @db.VarChar(60)
  value Json
}

// -----------------------------------------------------------------------------
// Ao vivo: vídeo WebRTC direto do navegador de quem transmite para cada
// espectador (sinalização por polling nesta tabela), chat e gorjetas.
// -----------------------------------------------------------------------------

enum LiveStatus {
  LIVE
  ENDED
}

enum LiveMessageKind {
  TEXT
  TIP
  SYSTEM
}

model LiveStream {
  id          String        @id @default(cuid())
  hostId      String
  title       String        @db.VarChar(80)
  audience    String        @default("ALL") @db.VarChar(10) // ALL | VIP (só assinantes assistem)
  tipGoal     Int?
  goalLabel   String?       @db.VarChar(60)
  tipTotal    Int           @default(0)
  peakViewers Int           @default(0)
  status      LiveStatus    @default(LIVE)
  startedAt   DateTime      @default(now())
  lastBeatAt  DateTime      @default(now()) // heartbeat de quem transmite
  endedAt     DateTime?
  endReason   String?       @db.VarChar(120)
  host        User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  viewers     LiveViewer[]
  messages    LiveMessage[]
  signals     LiveSignal[]
  bans        LiveBan[]

  @@index([status, startedAt])
  @@index([hostId, status])
}

model LiveViewer {
  streamId   String
  userId     String
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  tipped     Int        @default(0)
  stream     LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([streamId, userId])
  @@index([streamId, lastSeenAt])
}

model LiveMessage {
  id        BigInt          @id @default(autoincrement())
  streamId  String
  authorId  String?
  kind      LiveMessageKind @default(TEXT)
  body      String          @db.VarChar(500)
  amount    Int?
  createdAt DateTime        @default(now())
  deletedAt DateTime?
  stream    LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([streamId, id])
  @@index([authorId, createdAt])
}

/// Mensagens de sinalização WebRTC (offer/answer/hello/bye/full). Apagadas após poucos minutos.
model LiveSignal {
  id        BigInt     @id @default(autoincrement())
  streamId  String
  fromId    String
  toId      String
  kind      String     @db.VarChar(10)
  payload   String?    @db.MediumText
  createdAt DateTime   @default(now())
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId, toId, id])
  @@index([createdAt])
}

/// Espectador removido pela pessoa que transmite (ou pela moderação).
model LiveBan {
  streamId  String
  userId    String
  createdAt DateTime   @default(now())
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([streamId, userId])
}

/// Etapa pendente de login social (completar cadastro / código 2FA). Cookie guarda só o token.
model OAuthPending {
  id        String   @id @db.VarChar(64) // sha256 do token do cookie
  kind      String   @db.VarChar(10) // SIGNUP | TWOFA
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// "Quem visitou meu perfil" (estilo Sexlog). Uma linha por par; purgado após 90 dias.
model ProfileVisit {
  visitedId String
  visitorId String
  count     Int      @default(1)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@id([visitedId, visitorId])
  @@index([visitedId, lastAt])
  @@index([lastAt])
}

// -----------------------------------------------------------------------------
// Eventos (festas e encontros liberais, estilo Sexlog). Só aparecem após aprovação.
// -----------------------------------------------------------------------------

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model Event {
  id           String      @id @default(cuid())
  creatorId    String
  title        String      @db.VarChar(90)
  description  String      @db.Text
  startsAt     DateTime
  endsAt       DateTime?
  state        String      @db.VarChar(2)
  city         String      @db.VarChar(80)
  venue        String      @db.VarChar(120)
  priceText    String?     @db.VarChar(80)
  audience     String      @default("ALL") @db.VarChar(10) // ALL | COUPLES
  coverMediaId String?
  status       EventStatus @default(PENDING)
  reviewNote   String?     @db.VarChar(200)
  reviewedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  creator      User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps        EventRsvp[]

  @@index([status, startsAt])
  @@index([state, startsAt])
  @@index([creatorId])
}

model EventRsvp {
  eventId   String
  userId    String
  status    String   @db.VarChar(6) // GOING | MAYBE
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Grupos por interesse (criados pela equipe do site). Posts de grupo ficam no grupo.
// -----------------------------------------------------------------------------

model Group {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(40)
  name        String        @db.VarChar(60)
  description String        @db.Text
  emoji       String        @default("💬") @db.VarChar(8)
  audience    String        @default("ALL") @db.VarChar(10) // ALL | COUPLES
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  posts       Post[]
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Depoimentos (referências entre perfis): o dono do perfil aprova antes de publicar
// -----------------------------------------------------------------------------

model Testimonial {
  id          String    @id @default(cuid())
  profileId   String
  authorId    String
  body        String    @db.Text
  metInPerson Boolean   @default(false)
  /// PENDING | APPROVED | HIDDEN
  status      String    @default("PENDING") @db.VarChar(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewedAt  DateTime?
  /// apagado pelo autor: a linha fica (sem texto) para não reabrir um depoimento ocultado
  withdrawnAt DateTime?
  profile     User      @relation("TestimonialsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  author      User      @relation("TestimonialsWritten", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([profileId, authorId])
  @@index([profileId, status, createdAt])
  @@index([authorId])
}

// -----------------------------------------------------------------------------
// Stories: fotos que somem em 24 h (guardadas mais alguns dias só para moderação)
// -----------------------------------------------------------------------------

model Story {
  id        String      @id @default(cuid())
  authorId  String
  mediaId   String
  caption   String?     @db.VarChar(140)
  /// ALL | FRIENDS
  audience  String      @default("ALL") @db.VarChar(10)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  deletedAt DateTime?
  author    User        @relation("StoriesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
  @@index([mediaId])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([viewerId])
}

// -----------------------------------------------------------------------------
// Álbuns por tema: cada um com quem pode ver definido separadamente
// -----------------------------------------------------------------------------

model Album {
  id         String              @id @default(cuid())
  ownerId    String
  name       String              @db.VarChar(40)
  emoji      String              @default("📁") @db.VarChar(8)
  /// VERIFIED | FOLLOWERS | FRIENDS | PRIVATE (só quem o dono liberar)
  visibility String              @default("PRIVATE") @db.VarChar(10)
  position   Int                 @default(0)
  createdAt  DateTime            @default(now())
  owner      User                @relation("AlbumsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  access     ThemedAlbumAccess[]

  @@index([ownerId, position])
}

/// Pedido/liberação de acesso a UM álbum por tema (não abre os outros álbuns do dono)
model ThemedAlbumAccess {
  albumId   String
  viewerId  String
  granted   Boolean  @default(false)
  createdAt DateTime @default(now())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([albumId, viewerId])
  @@index([viewerId])
}

// -----------------------------------------------------------------------------
// Notificações push (PWA): uma inscrição por aparelho, presa à sessão de login
// (sair da conta ou a sessão vencer apaga a inscrição daquele aparelho)
// -----------------------------------------------------------------------------

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String
  endpointHash String    @unique @db.VarChar(64)
  endpoint     String    @db.Text
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @db.VarChar(200)
  createdAt    DateTime  @default(now())
  lastOkAt     DateTime?
  user         User      @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

// -----------------------------------------------------------------------------
// Enquetes nas salas (moderador/dono/equipe abre; cada pessoa tem 1 voto, pode trocar)
// -----------------------------------------------------------------------------

model RoomPoll {
  id        String         @id @default(cuid())
  roomId    String
  creatorId String
  question  String         @db.VarChar(140)
  /// lista de opções (2 a 5 textos)
  options   Json
  endsAt    DateTime
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  votes     RoomPollVote[]

  @@index([roomId, createdAt])
}

model RoomPollVote {
  pollId    String
  userId    String
  option    Int
  createdAt DateTime @default(now())
  poll      RoomPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Paquera: curtir/passar perfis; curtida recíproca = match
// -----------------------------------------------------------------------------

model ProfileLike {
  likerId     String
  likedId     String
  createdAt   DateTime  @default(now())
  /// desfeita: a linha fica (curtir de novo não gera outro aviso; evita spam de curtir/descurtir)
  withdrawnAt DateTime?

  @@id([likerId, likedId])
  @@index([likedId, createdAt])
}

/// "Passar": o perfil some da Paquera por um tempo
model ProfileSkip {
  userId    String
  skippedId String
  createdAt DateTime @default(now())

  @@id([userId, skippedId])
  @@index([createdAt])
}
