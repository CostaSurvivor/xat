# Banco MySQL (Hostinger: hPanel → Bancos de dados → MySQL)
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO"

# Nome da plataforma e da moeda
NEXT_PUBLIC_SITE_NAME="SexPapo"
NEXT_PUBLIC_CURRENCY_NAME="Pimentas"

# E-mails que viram ADMIN automaticamente ao se cadastrar (separe por vírgula)
ADMIN_EMAILS="seu-email@exemplo.com"

# Pasta das fotos/vídeos. Na Hostinger use um caminho FORA da pasta do app,
# ex.: /home/u123456789/storage-sexpapo (senão um redeploy pode apagar as mídias)
UPLOAD_DIR="./storage"

# Tamanho máximo de vídeo (MB)
MAX_VIDEO_MB="100"

# Fotos só aparecem nítidas para perfis verificados (recomendado: true)
MEDIA_REQUIRES_VERIFICATION="true"

# Pix manual (opcional aqui): o jeito recomendado é cadastrar em Admin → Configurações.
# Estes valores só são usados se nada estiver salvo no painel.
PIX_KEY="sua-chave-pix@exemplo.com"
PIX_MERCHANT_NAME="SexPapo"
PIX_MERCHANT_CITY="Sao Paulo"

# E-mail do encarregado de dados (LGPD), aparece na Política de Privacidade
DPO_EMAIL="privacidade@exemplo.com"

# E-mail (recuperar senha e recibos). Hostinger: crie uma caixa em hPanel → E-mails.
PUBLIC_URL="https://seu-dominio.com"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="nao-responda@seu-dominio.com"
SMTP_PASS=""
MAIL_FROM="SexPapo <nao-responda@seu-dominio.com>"

# Fundador (visual exclusivo no chat)
FOUNDER_EMAILS="admin@sexpapo.com"

# Detecção de CSAM (opcional; PhotoDNA/Thorn Safer exigem cadastro). Veja src/server/csam.ts
CSAM_SCAN_URL=""
CSAM_SCAN_KEY=""

# Gateway de pagamento (opcional; padrão é Pix manual). Veja src/server/payments/
PAYMENT_PROVIDER="pix_manual"

# Ao vivo (WebRTC direto do navegador; o servidor não recebe o vídeo)
LIVE_MAX_VIEWERS="10"          # espectadores com vídeo por transmissão (usa o upload de quem transmite)
LIVE_TIP_FEE_PCT="0"           # % da gorjeta que fica com a plataforma
LIVE_REQUIRE_SUBSCRIBER="0"    # 1 = só assinantes transmitem
LIVE_STUN_URLS="stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478"
LIVE_TURN_URLS=""              # recomendado p/ 4G/5G (CGNAT): ex. turn:turn.seu-provedor.com:3478?transport=udp
LIVE_TURN_USERNAME=""
LIVE_TURN_CREDENTIAL=""
