// =============================================================================
// [NOME] — schema do banco (PostgreSQL + Prisma)
// Etapa 1: proposta para aprovação. Nada aqui foi migrado ainda.
//
// Convenções
// - IDs: cuid (texto). Mensagens usam BigInt autoincrement p/ paginação barata.
// - Dinheiro real: centavos (Int) + moeda. Moeda virtual: Int (unidades inteiras).
// - Saldo de moeda só muda junto com um LedgerTransaction na MESMA transação SQL.
//   Uma migration SQL extra cria triggers que proíbem UPDATE/DELETE no ledger.
// - Dados sensíveis (vida sexual — LGPD art. 11) ficam em Profile e só são
//   gravados após ConsentRecord(SENSITIVE_DATA).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum PlatformRole {
  USER
  MODERATOR // modera denúncias/verificações da plataforma
  ADMIN
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  BANNED
  DELETED // anonimizado; linha mantida p/ integridade do ledger e logs legais
}

enum ProfileType {
  COUPLE_MF
  COUPLE_MM
  COUPLE_FF
  SINGLE_WOMAN
  SINGLE_MAN
  TRANS
  OTHER
}

enum PmPolicy {
  EVERYONE
  FOLLOWING
  COUPLES
  NOBODY
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ConsentKind {
  TERMS
  PRIVACY
  SENSITIVE_DATA
  AGE_DECLARATION
  MARKETING
}

enum MediaKind {
  AVATAR
  PUBLIC_PHOTO
  PRIVATE_ALBUM
  PM_PHOTO
  VERIFICATION_SELFIE
  ROOM_COVER
  ITEM_ICON
}

enum MediaStatus {
  PENDING_SCAN
  APPROVED
  QUARANTINED // bloqueio imediato (hash match / denúncia de menor)
  REMOVED
}

enum AlbumAccessStatus {
  REQUESTED
  GRANTED
  DENIED
  REVOKED
}

enum RoomAccess {
  PUBLIC
  MEMBERS_ONLY
  COUPLES_ONLY
  VERIFIED_ONLY
}

enum RoomMediaPolicy {
  NOBODY
  MODERATORS
  MEMBERS
  EVERYONE_VERIFIED
}

enum RoomRole {
  OWNER
  MODERATOR
  MEMBER
  // "Convidado" = usuário sem linha em RoomMember
}

enum RoomStatus {
  ACTIVE
  LOCKED
  REMOVED
}

enum RoomSanctionType {
  MUTE
  KICK
  BAN
}

enum MessageKind {
  TEXT
  SYSTEM
  GIFT
  ANNOUNCEMENT
  ENTRY
}

enum ItemCategory {
  GLOW
  NICK_COLOR
  NICK_FONT
  TEXT_COLOR
  BADGE
  AVATAR_FRAME
  ENTRY_EFFECT
  POWER
}

enum PowerKey {
  INVISIBLE
  BIG_NICK
  PIN_MESSAGE
  HIGHLIGHT_ONLINE
  PRIORITY_PM
}

enum ItemRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  LIMITED
}

enum AcquiredVia {
  PURCHASE
  GIFT
  VIP
  ADMIN
  COUPON
}

enum WalletKind {
  USER
  SYSTEM_MINT // origem de moeda comprada/bônus (saldo negativo = moeda emitida)
  SYSTEM_SINK // destino de moeda gasta na loja
}

enum LedgerTxType {
  PURCHASE_CREDIT
  VIP_BONUS
  COUPON_BONUS
  ITEM_PURCHASE
  GIFT_COINS
  GIFT_ITEM
  REFUND
  CHARGEBACK_REVERSAL
  ADMIN_ADJUSTMENT
}

enum PaymentMethod {
  PIX
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CHARGEBACK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CouponType {
  BONUS_COINS
  PERCENT_OFF
}

enum ReportTargetType {
  USER
  ROOM_MESSAGE
  PRIVATE_MESSAGE
  MEDIA
  ROOM
}

enum ReportReason {
  POSSIBLE_MINOR // prioridade máxima
  NON_CONSENSUAL // fotos de terceiros / sem consentimento
  ILLEGAL_CONTENT
  HARASSMENT
  FAKE_PROFILE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ESCALATED // encaminhado às autoridades
  RESOLVED
  DISMISSED
}

enum PlatformSanctionType {
  WARNING
  MEDIA_BLOCK
  SUSPENSION
  BAN
}

enum FingerprintKind {
  IP
  DEVICE
  EMAIL_HASH
}

enum LegalAgency {
  SAFERNET
  POLICIA_FEDERAL
  NCMEC
  OTHER
}

enum DataRequestKind {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// -----------------------------------------------------------------------------
// Identidade, auth e sessões
// -----------------------------------------------------------------------------

model User {
  id                 String       @id @default(cuid())
  email              String       @unique // armazenado em minúsculas
  emailVerifiedAt    DateTime?
  passwordHash       String? // argon2id; null se só Google
  nick               String       @unique // exibição
  nickLower          String       @unique
  birthDate          DateTime     @db.Date // titular da conta; casais têm ProfilePerson
  platformRole       PlatformRole @default(USER)
  status             UserStatus   @default(PENDING_EMAIL)
  ageVerification    VerificationStatus @default(NONE) // libera mídia, PV e compras
  ageVerifiedAt      DateTime?
  profileVerified    VerificationStatus @default(NONE) // selo "verificado"
  twoFactorEnabled   Boolean      @default(false)
  twoFactorSecretEnc String? // TOTP secret cifrado (AES-GCM, chave fora do banco)
  lastSeenAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  accounts        OAuthAccount[]
  sessions        Session[]
  profile         Profile?
  consents        ConsentRecord[]
  verifications   VerificationRequest[] @relation("VerificationSubject")
  reviewedVerifs  VerificationRequest[] @relation("VerificationReviewer")
  media           Media[]
  wallet          Wallet?
  inventory       InventoryItem[]
  payments        Payment[]
  subscriptions   Subscription[]
  roomsOwned      Room[]                @relation("RoomOwner")
  roomMemberships RoomMember[]
  messages        Message[]
  reactions       MessageReaction[]
  pmSent          PrivateMessage[]
  following       Follow[]              @relation("Follower")
  followers       Follow[]              @relation("Followee")
  blocking        Block[]               @relation("Blocker")
  blockedBy       Block[]               @relation("Blocked")
  reportsFiled    Report[]              @relation("Reporter")
  reportsAssigned Report[]              @relation("ReportAssignee")
  sanctions       PlatformSanction[]    @relation("SanctionTarget")
  sanctionsIssued PlatformSanction[]    @relation("SanctionIssuer")
  giftsSent       Gift[]                @relation("GiftFrom")
  giftsReceived   Gift[]                @relation("GiftTo")
  accessLogs      AccessLog[]
  dataRequests    DataRequest[]

  @@index([status])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String // "google"
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 do token do cookie httpOnly
  deviceId   String? // cookie de dispositivo persistente (p/ ban por dispositivo)
  ip         String
  userAgent  String?
  twoFactorOk Boolean  @default(false)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// Registro de consentimentos LGPD (versões dos termos aceitos)
model ConsentRecord {
  id        String      @id @default(cuid())
  userId    String
  kind      ConsentKind
  version   String
  ip        String
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// -----------------------------------------------------------------------------
// Perfil
// -----------------------------------------------------------------------------

model Profile {
  userId             String      @id
  type               ProfileType
  bio                String?     @db.VarChar(1000)
  city               String?
  state              String?     @db.Char(2)
  hideCity           Boolean     @default(false)
  hideFromUnverified Boolean     @default(false)
  likes              String[] // tags "o que curte" (catálogo controlado)
  seeking            String[] // tags "o que procura"
  pmPolicy           PmPolicy    @default(EVERYONE)
  acceptPmPhotos     Boolean     @default(false) // foto no PV só se ambos true
  avatarMediaId      String?     @unique
  updatedAt          DateTime    @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar  Media?          @relation("ProfileAvatar", fields: [avatarMediaId], references: [id])
  persons ProfilePerson[]

  @@index([state, city])
  @@index([type])
}

// Pessoas do perfil: 1 para solteiros, 2 para casais. Ambas devem ser 18+.
model ProfilePerson {
  id          String   @id @default(cuid())
  profileId   String
  label       String // "Ele", "Ela", "Pessoa 1"...
  gender      String?
  birthDate   DateTime @db.Date
  profile     Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@index([profileId])
}

// Verificação por selfie com gesto (idade e/ou selo). Casais: ambos na selfie.
model VerificationRequest {
  id            String             @id @default(cuid())
  userId        String
  purpose       String // AGE | PROFILE_BADGE | BOTH
  gestureCode   String // gesto sorteado (ex.: "mão aberta + 3 dedos")
  selfieMediaId String             @unique
  status        VerificationStatus @default(PENDING)
  reviewerId    String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime           @default(now())

  user     User  @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id])
  selfie   Media @relation("VerificationSelfie", fields: [selfieMediaId], references: [id])

  @@index([status, createdAt])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// -----------------------------------------------------------------------------
// Mídia (R2 / S3). Nunca servida direto: só por URL assinada curta.
// -----------------------------------------------------------------------------

model Media {
  id          String      @id @default(cuid())
  ownerId     String
  kind        MediaKind
  status      MediaStatus @default(PENDING_SCAN)
  storageKey  String      @unique // original (bucket privado)
  blurredKey  String? // versão borrada (PV / prévia)
  mime        String
  width       Int?
  height      Int?
  sizeBytes   Int
  sha256      String
  pHash       String? // hash perceptual p/ blocklist e duplicatas
  position    Int? // ordem em fotos públicas / álbum privado
  scannedAt   DateTime?
  scanResult  Json?
  createdAt   DateTime    @default(now())
  removedAt   DateTime?

  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  profileAvatar  Profile?              @relation("ProfileAvatar")
  verification   VerificationRequest?  @relation("VerificationSelfie")
  privateMessage PrivateMessage?
  escalations    LegalEscalation[]

  @@index([ownerId, kind])
  @@index([sha256])
  @@index([status])
}

// Hashes proibidos (listas externas de CSAM + remoções internas)
model MediaHashBlock {
  id        String   @id @default(cuid())
  algo      String // sha256 | phash | photodna
  hash      String
  source    String // "internal" | nome do provedor
  createdAt DateTime @default(now())

  @@unique([algo, hash])
}

// Pedido/liberação do álbum privado (por dono → visitante)
model AlbumAccess {
  ownerId   String
  viewerId  String
  status    AlbumAccessStatus @default(REQUESTED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@id([ownerId, viewerId])
  @@index([viewerId])
}

// -----------------------------------------------------------------------------
// Salas
// -----------------------------------------------------------------------------

model Room {
  id              String          @id @default(cuid())
  slug            String          @unique // minúsculo, [a-z0-9-], lista de reservados no código
  name            String          @db.VarChar(60)
  description     String?         @db.VarChar(500)
  rules           String?         @db.VarChar(2000)
  coverMediaId    String?
  themePreset     String          @default("noir") // tema escolhido de lista fixa
  accentColor     String? // #RRGGBB validado
  city            String?
  state           String?         @db.Char(2)
  tags            String[]
  isOfficial      Boolean         @default(false)
  ownerId         String?
  access          RoomAccess      @default(PUBLIC)
  mediaPolicy     RoomMediaPolicy @default(NOBODY)
  slowModeSeconds Int             @default(0)
  linksAllowed    Boolean         @default(false)
  status          RoomStatus      @default(ACTIVE)
  pinnedMessageId BigInt?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner        User?             @relation("RoomOwner", fields: [ownerId], references: [id])
  members      RoomMember[]
  bannedWords  RoomBannedWord[]
  sanctions    RoomSanction[]
  messages     Message[]

  @@index([state, city])
  @@index([isOfficial])
  @@index([status])
}

model RoomMember {
  roomId   String
  userId   String
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model RoomBannedWord {
  id     String @id @default(cuid())
  roomId String
  word   String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, word])
}

model RoomSanction {
  id         String           @id @default(cuid())
  roomId     String
  userId     String
  type       RoomSanctionType
  reason     String?
  issuedById String
  createdAt  DateTime         @default(now())
  expiresAt  DateTime? // null = permanente (BAN) / instantâneo (KICK)
  revokedAt  DateTime?
  room       Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, userId, type])
}

// Mensagens de sala. BigInt p/ paginação por cursor (id < X).
model Message {
  id          BigInt      @id @default(autoincrement())
  roomId      String
  authorId    String?
  kind        MessageKind @default(TEXT)
  body        String      @db.VarChar(2000) // texto puro; renderização escapa tudo
  mentions    String[] // userIds mencionados
  styleSnap   Json? // snapshot dos itens ativos do autor (IDs de catálogo, não CSS)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  deletedById String?

  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions MessageReaction[]

  @@index([roomId, id])
  @@index([authorId])
}

model MessageReaction {
  messageId BigInt
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model Announcement {
  id          String    @id @default(cuid())
  body        String    @db.VarChar(1000)
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

// -----------------------------------------------------------------------------
// Mensagens privadas (PV)
// -----------------------------------------------------------------------------

model Conversation {
  id            String   @id @default(cuid())
  userAId       String // menor id (ordenado) — garante 1 conversa por par
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages PrivateMessage[]
  states   ConversationState[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model ConversationState {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  archived       Boolean   @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model PrivateMessage {
  id             BigInt    @id @default(autoincrement())
  conversationId String
  senderId       String
  body           String?   @db.VarChar(2000)
  mediaId        String?   @unique // PM_PHOTO; só se ambos acceptPmPhotos + idade verificada
  revealedAt     DateTime? // destinatário clicou p/ ver (antes disso só blur)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  media        Media?       @relation(fields: [mediaId], references: [id])

  @@index([conversationId, id])
}

// -----------------------------------------------------------------------------
// Economia virtual — ledger de partidas dobradas
// Toda LedgerTransaction tem entradas cuja soma = 0.
// Wallet.balance é cache; atualizado na mesma tx SQL com checagem de versão.
// -----------------------------------------------------------------------------

model Wallet {
  id        String     @id @default(cuid())
  kind      WalletKind @default(USER)
  userId    String?    @unique
  balance   Int        @default(0) // CHECK (balance >= 0) p/ kind=USER via migration SQL
  version   Int        @default(0) // lock otimista
  updatedAt DateTime   @updatedAt

  user    User?         @relation(fields: [userId], references: [id])
  entries LedgerEntry[]
}

model LedgerTransaction {
  id             String       @id @default(cuid())
  type           LedgerTxType
  idempotencyKey String       @unique // ex.: "payment:<id>", "gift:<id>"
  refType        String? // Payment | InventoryItem | Gift | Coupon | Admin
  refId          String?
  note           String?
  createdById    String? // admin em ajustes manuais
  createdAt      DateTime     @default(now())

  entries LedgerEntry[]
}

model LedgerEntry {
  id            String   @id @default(cuid())
  transactionId String
  walletId      String
  amount        Int // + crédito / - débito
  balanceAfter  Int
  createdAt     DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([transactionId])
}

// -----------------------------------------------------------------------------
// Loja
// -----------------------------------------------------------------------------

// Item de catálogo. `config` é JSON TIPADO por categoria (validado com Zod) e
// compilado para CSS pelo servidor a partir de primitivas seguras
// (cores #hex, animações de uma lista fixa). Nunca CSS livre.
model Item {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  description       String?
  category          ItemCategory
  rarity            ItemRarity   @default(COMMON)
  config            Json
  powerKey          PowerKey?
  powerScore        Int          @default(0) // ordena lista de online
  iconMediaId       String?
  soundKey          String? // som de entrada (arquivo do catálogo)
  vipOnly           Boolean      @default(false)
  limitedQuantity   Int? // edição limitada
  soldCount         Int          @default(0)
  active            Boolean      @default(true)
  availableFrom     DateTime?
  availableUntil    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  prices    ItemPrice[]
  inventory InventoryItem[]
  gifts     Gift[]

  @@index([category, active])
}

model ItemPrice {
  id           String @id @default(cuid())
  itemId       String
  durationDays Int? // 7 | 30 | null = permanente
  price        Int // em moeda virtual
  item         Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, durationDays])
}

model InventoryItem {
  id          String      @id @default(cuid())
  userId      String
  itemId      String
  acquiredVia AcquiredVia
  giftId      String?
  active      Boolean     @default(false) // regra: 1 ativo por categoria (exceto BADGE/POWER)
  expiresAt   DateTime? // null = permanente
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([userId, active])
  @@index([expiresAt])
}

model Gift {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  itemId       String?
  durationDays Int?
  coins        Int?
  roomId       String? // se enviado numa sala, dispara animação lá
  message      String?  @db.VarChar(200)
  ledgerTxId   String   @unique
  createdAt    DateTime @default(now())

  from User  @relation("GiftFrom", fields: [fromId], references: [id])
  to   User  @relation("GiftTo", fields: [toId], references: [id])
  item Item? @relation(fields: [itemId], references: [id])

  @@index([toId])
}

model CoinPackage {
  id         String   @id @default(cuid())
  name       String
  coins      Int
  bonusCoins Int      @default(0)
  priceCents Int
  currency   String   @default("BRL")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  payments   Payment[]
}

model VipPlan {
  id           String         @id @default(cuid())
  name         String
  priceCents   Int
  currency     String         @default("BRL")
  periodDays   Int            @default(30)
  bonusCoins   Int            @default(0)
  benefits     Json // lista de itens/poderes concedidos enquanto ativo
  active       Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus
  provider           String
  providerSubId      String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())

  user User    @relation(fields: [userId], references: [id])
  plan VipPlan @relation(fields: [planId], references: [id])

  @@unique([provider, providerSubId])
  @@index([userId, status])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Int // moedas bônus ou % (0-100)
  maxRedemptions Int?
  perUserLimit   Int        @default(1)
  redeemedCount  Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  paymentId String?  @unique
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
}

// -----------------------------------------------------------------------------
// Pagamentos (camada PaymentProvider plugável)
// -----------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  userId            String
  provider          String // "segpay" | "ccbill" | "<pix-gateway>" | "fake"
  providerPaymentId String?
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          String        @default("BRL")
  packageId         String?
  couponId          String?
  coinsToCredit     Int // congelado na criação (pacote + bônus + cupom)
  ledgerTxId        String?       @unique // preenchido ao creditar (idempotente)
  pixQrCode         String?
  pixExpiresAt      DateTime?
  paidAt            DateTime?
  receiptSentAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  package CoinPackage? @relation(fields: [packageId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status])
}

// Todo webhook recebido é gravado ANTES de processar. (provider, eventId) único
// garante idempotência mesmo com reentregas.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  signatureOk Boolean
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
}

// -----------------------------------------------------------------------------
// Denúncias, moderação e legal
// -----------------------------------------------------------------------------

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  targetUserId String?
  reason       ReportReason
  details      String?          @db.VarChar(2000)
  priority     Int // POSSIBLE_MINOR=100, NON_CONSENSUAL=80, ILLEGAL=80, ...
  status       ReportStatus     @default(OPEN)
  assignedToId String?
  resolution   String?
  evidence     Json? // snapshot do conteúdo denunciado (preservação)
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  reporter    User              @relation("Reporter", fields: [reporterId], references: [id])
  assignedTo  User?             @relation("ReportAssignee", fields: [assignedToId], references: [id])
  escalations LegalEscalation[]
  sanctions   PlatformSanction[]

  @@index([status, priority, createdAt])
  @@index([targetUserId])
}

model PlatformSanction {
  id         String               @id @default(cuid())
  userId     String
  type       PlatformSanctionType
  reason     String
  reportId   String?
  issuedById String
  createdAt  DateTime             @default(now())
  expiresAt  DateTime? // null = permanente
  revokedAt  DateTime?

  user     User    @relation("SanctionTarget", fields: [userId], references: [id])
  issuedBy User    @relation("SanctionIssuer", fields: [issuedById], references: [id])
  report   Report? @relation(fields: [reportId], references: [id])

  @@index([userId])
}

// Ban por IP / dispositivo / e-mail (valores com hash + pepper)
model BanFingerprint {
  id        String          @id @default(cuid())
  kind      FingerprintKind
  valueHash String
  reason    String?
  sanctionId String?
  createdAt DateTime        @default(now())
  expiresAt DateTime?

  @@unique([kind, valueHash])
}

// Encaminhamento às autoridades (SaferNet / PF). Evidência preservada
// fora do fluxo normal de exclusão.
model LegalEscalation {
  id            String      @id @default(cuid())
  reportId      String?
  mediaId       String?
  agency        LegalAgency
  protocol      String?
  notes         String?
  submittedById String
  submittedAt   DateTime    @default(now())

  report Report? @relation(fields: [reportId], references: [id])
  media  Media?  @relation(fields: [mediaId], references: [id])
}

// Marco Civil art. 15: registros de acesso a aplicação por 6 meses.
// Particionar por mês (migration SQL) e expurgar partições > 6 meses.
model AccessLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  event     String // LOGIN | LOGOUT | SOCKET_CONNECT | ...
  ip        String
  port      Int? // porta de origem (exigida p/ IPs compartilhados / CGNAT)
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Auditoria de ações administrativas e de moderação
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  kind        DataRequestKind
  status      DataRequestStatus @default(PENDING)
  resultKey   String? // zip no storage (export), URL assinada curta
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  user        User              @relation(fields: [userId], references: [id])
}

// Configurações globais editáveis no admin (ex.: nome da moeda "Pimentas")
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
